PORT=3000

# typeorm | drizzle | sequelize | prisma | mikroorm
DB_PROVIDER=typeorm

DB_HOST=localhost
DB_PORT=15432
DB_USER=db-nest
DB_PASSWORD=db-nest
DB_NAME=db-nest_db
DB_LOGGING=false
# Relative to process cwd (monolit/) or absolute path
DB_QUERY_LOG_PATH=logs/db-queries.log

# Used by Prisma / optional override for other providers
DATABASE_URL=postgresql://db-nest:db-nest@localhost:15432/db-nest_db
# Title projector / CDC rebuild reads (Postgres replica). Falls back to DATABASE_URL.
PROJECTOR_DATABASE_URL=postgresql://db-nest:db-nest@localhost:15433/db-nest_db

# CQRS Title read model (orm | mongo)
TITLE_READ_STORE=orm
MONGO_URL=mongodb://db-nest:db-nest@localhost:17017/db-nest_db?authSource=admin
KAFKA_BROKERS=localhost:19092,localhost:19093,localhost:19094,localhost:19095
KAFKA_CDC_GROUP=db-nest-title-projector
KAFKA_CDC_TOPIC_PREFIX=db-nest
KAFKA_CDC_FROM_BEGINNING=true
KAFKA_CDC_DEBOUNCE_MS=12000
KAFKA_CDC_FLUSH_CONCURRENCY=6
KAFKA_CDC_FLUSH_BATCH=40
