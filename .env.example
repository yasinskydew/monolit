PORT=3000

# typeorm | drizzle | sequelize | prisma | mikroorm
DB_PROVIDER=typeorm

DB_HOST=localhost
DB_PORT=15432
DB_USER=db-nest
DB_PASSWORD=db-nest
DB_NAME=db-nest_db
DB_LOGGING=false
# Relative to process cwd (monolit/) or absolute path
DB_QUERY_LOG_PATH=logs/db-queries.log

# Used by Prisma / optional override for other providers
DATABASE_URL=postgresql://db-nest:db-nest@localhost:15432/db-nest_db
